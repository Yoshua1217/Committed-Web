rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /note-files/{userId}/{noteId}/{fileId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && ((request.resource.contentType == 'application/pdf' && request.resource.size <= 100 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 200 * 1024 * 1024));
    }
    match /note-images/{userId}/{noteId}/{imageId} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
    }
  }
}
