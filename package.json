{
  "name": "committed-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "next dev",
    "dev:ink-lab": "node scripts/ink-lab.mjs",
    "test:ink-rules": "firebase emulators:exec --only firestore,storage --project demo-ink-workspace --config firebase.ink-tests.json \"node --test tests/ink.rules.mjs tests/ink-storage.rules.mjs\"",
    "build": "next build",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "start": "next start",
    "lint": "eslint",
    "test:habit-rules": "firebase emulators:exec --only firestore --project demo-habit-history --config firebase.habit-tests.json \"node --test tests/habit-history.rules.mjs\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "firebase": "^12.10.0",
    "katex": "^0.18.5",
    "next": "16.1.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
